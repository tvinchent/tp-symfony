<!doctype html>
<html lang="fr"><head><meta charset="utf-8"><meta name="viewport" content="width=device-width, initial-scale=1"><title>{% block title %}Catalogue{% endblock %}</title>
<style>body{font-family:system-ui;margin:0;background:#f4f6fa;color:#162235}header,footer{background:#14283f;color:#fff;padding:1.2rem}main{max-width:1080px;margin:2rem auto;padding:0 1rem}.grid{display:grid;grid-template-columns:repeat(auto-fit,minmax(210px,1fr));gap:1rem}.card{padding:1rem;background:white;border-radius:12px;box-shadow:0 2px 12px #0001}.card img{width:100%;height:130px;object-fit:cover}</style>
</head><body><header><strong>Catalogue de jeux</strong></header><main>{% block body %}{% endblock %}</main><footer>TP Symfony / Twig</footer></body></html>
